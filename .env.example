# TaskFlow Environment Variables
# Copy this file to .env and fill in your values

# GitHub OAuth (for commit auto-completion feature)
# 1. Go to https://github.com/settings/developers
# 2. Create a new OAuth App
# 3. Set Homepage URL to http://localhost:5173
# 4. Set Authorization callback URL to http://localhost:5173/auth/github/callback
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback

# OpenAI API Key (for AI task breakdown feature)
# 1. Go to https://platform.openai.com/api-keys
# 2. Create a new API key
# Note: This feature is optional - the app works without it
VITE_OPENAI_API_KEY=your_openai_api_key_here
